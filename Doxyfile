# Doxygen configuration for the NURBS library's API reference.
# Only settings that differ from Doxygen's defaults are listed; run
# `doxygen -x Doxyfile` to see them against the full default set.
# Run `doxygen` from the repository root; output goes to build-docs/html.

PROJECT_NAME           = NURBS
PROJECT_BRIEF          = "A C++23 NURBS library implementing the algorithms from The NURBS Book"
OUTPUT_DIRECTORY       = build-docs

INPUT                  = README.md \
                         NURBS.Lib/include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
USE_MDFILE_AS_MAINPAGE = README.md
STRIP_FROM_INC_PATH    = NURBS.Lib/include

# Leave EXTRACT_ALL off: with it on, Doxygen treats every entity as documented
# and WARN_IF_UNDOCUMENTED can no longer report anything.
EXTRACT_ALL            = NO
JAVADOC_AUTOBRIEF      = YES

# Every public entity must be documented, including each parameter and the
# return value, and any warning fails the run (with all warnings still
# listed). CI relies on this to reject undocumented code.
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build-docs/warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
