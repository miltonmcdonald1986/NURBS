{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "NURBS_BUILD_TESTS": "ON",
                "NURBS_BUILD_VIEWER": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-msvc",
            "hidden": true,
            "inherits": "base",
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug (MSVC)",
            "inherits": "windows-msvc",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release (MSVC)",
            "inherits": "windows-msvc",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (GCC)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug (AppleClang)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        }
    ],
    "buildPresets": [
        { "name": "x64-debug", "configurePreset": "x64-debug" },
        { "name": "x64-release", "configurePreset": "x64-release" },
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "macos-debug", "configurePreset": "macos-debug" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true }
        },
        { "name": "x64-debug", "inherits": "base", "configurePreset": "x64-debug" },
        { "name": "x64-release", "inherits": "base", "configurePreset": "x64-release" },
        { "name": "linux-debug", "inherits": "base", "configurePreset": "linux-debug" },
        { "name": "macos-debug", "inherits": "base", "configurePreset": "macos-debug" }
    ]
}
